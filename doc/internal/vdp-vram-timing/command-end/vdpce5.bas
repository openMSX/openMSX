10 ' VDPCE5, fully automatic: when R#44 is taken, and STOP, in SCREEN 5 with
20 ' the display off, in 1-cycle steps (VDPCE5.ASM). One run per DATA
30 ' line: name, mode (0: CE or TR; 4: R#44 at T, which lands), coarse
40 ' delay, expected colour, flags, new byte, VRAM address, the
50 ' reference pixel (SX, SY), R#32-R#46. Results: I<name><V>W<w>.BIN
60 ' (V: 8 = V9938, 9 = V9958), the BSAVEd counters: class 0 and 1, per
70 ' i = 0..319, 16 bits each; a line per run in LOG.TXT. Existing result
80 ' files are skipped.
90 CLEAR 300,&H9FFF:SCREEN 0:WIDTH 80:KEY OFF:COLOR 15,4,4
100 BLOAD "VDPCE5.BIN":DEFUSR=&HC000
110 W=0:IF PEEK(&H2D)>=3 THEN W=1
120 V$="8":IF ((VDP(-1)\2) AND 31)=2 THEN V$="9"
125 ON ERROR GOTO 920:OPEN "LOG.TXT" FOR INPUT AS #1:CLOSE #1:ON ERROR GOTO 0
130 READ N$:IF N$="*" THEN 400
135 READ MO,CO,EX,FL,NB:POKE &HC004,MO:POKE &HC005,CO:POKE &HC006,EX:POKE &HC009,FL:POKE &HC00A,NB
137 FOR J=0 TO 6:READ X:POKE &HC01F+J,X:NEXT:FOR J=0 TO 14:READ X:POKE &HC010+J,X:NEXT
140 F$="I"+N$+V$+"W"+MID$(STR$(W),2)+".BIN"
150 ON ERROR GOTO 900:OPEN F$ FOR INPUT AS #1:CLOSE #1:ON ERROR GOTO 0:PRINT "Skipping ";F$:GOTO 130
160 ON ERROR GOTO 0:PRINT "Run ";N$;" -> ";F$
190 SCREEN 5:VDP(9)=VDP(9) AND &HFD:VDP(1)=VDP(1) AND &HBF
220 A=USR(0)
230 V8=VDP(9):V9=VDP(10):SCREEN 0:WIDTH 80
240 BSAVE F$,&HA000,&HA4FF
250 OPEN "LOG.TXT" FOR APPEND AS #1:PRINT #1,F$;" R#8=";V8;" R#9=";V9:CLOSE #1
260 GOTO 130
400 PRINT "All done.":POKE &HC008,255:BEEP:END
900 RESUME 160
920 RESUME 925
925 OPEN "LOG.TXT" FOR OUTPUT AS #1:CLOSE #1:ON ERROR GOTO 0:GOTO 130
