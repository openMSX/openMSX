10 ' VDPCE, fully automatic: when CE clears after a command, in SCREEN 5
20 ' with the display off, read 19 to 338 Z80 cycles after the OUT that
30 ' starts it, in 1-cycle steps (VDPCE.ASM). One run per DATA line: name,
40 ' mode (0: read CE; 1: write R#46 again, then read CE), coarse delay,
50 ' R#32-R#46. Results:
60 ' E<name><V>W<w>.BIN (V: 8 = V9938, 9 = V9958), the BSAVEd counters:
70 ' for each class 0..2 the trials per i = 0..319 (16 bits each); and a
80 ' line per run in LOG.TXT. Existing result files are skipped.
90 CLEAR 300,&H9FFF:SCREEN 0:WIDTH 80:KEY OFF:COLOR 15,4,4
100 BLOAD "VDPCE.BIN":DEFUSR=&HC000
110 W=0:IF PEEK(&H2D)>=3 THEN W=1
120 V$="8":IF ((VDP(-1)\2) AND 31)=2 THEN V$="9"
125 ON ERROR GOTO 920:OPEN "LOG.TXT" FOR INPUT AS #1:CLOSE #1:ON ERROR GOTO 0
130 READ N$,MO,CO:IF N$="*" THEN 400
135 FOR J=0 TO 14:READ X:POKE &HC010+J,X:NEXT
140 F$="E"+N$+V$+"W"+MID$(STR$(W),2)+".BIN"
150 ON ERROR GOTO 900:OPEN F$ FOR INPUT AS #1:CLOSE #1:ON ERROR GOTO 0:PRINT "Skipping ";F$:GOTO 130
160 ON ERROR GOTO 0:PRINT "Run ";N$;" -> ";F$
180 POKE &HC004,MO:POKE &HC005,CO
190 SCREEN 5:VDP(9)=VDP(9) AND &HFD:VDP(1)=VDP(1) AND &HBF
220 A=USR(0)
230 V8=VDP(9):V9=VDP(10):SCREEN 0:WIDTH 80
240 BSAVE F$,&HA000,&HA77F
250 OPEN "LOG.TXT" FOR APPEND AS #1:PRINT #1,F$;" R#8=";V8;" R#9=";V9:CLOSE #1
260 GOTO 130
400 PRINT "All done.":POKE &HC008,255:BEEP:END
900 RESUME 160
920 RESUME 925
925 OPEN "LOG.TXT" FOR OUTPUT AS #1:CLOSE #1:ON ERROR GOTO 0:GOTO 130
