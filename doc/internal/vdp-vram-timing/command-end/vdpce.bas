1030 DATA LV1,0,0,0,0,0,0,0,0,44,1,1,0,1,0,15,0,128
1040 DATA LVG,0,0,0,0,0,0,0,0,44,1,16,0,1,0,15,0,128
1050 DATA HM1,0,0,0,0,144,1,0,0,44,1,2,0,1,0,0,0,208
1060 DATA HMG,0,0,0,0,144,1,0,0,44,1,32,0,1,0,0,0,208
