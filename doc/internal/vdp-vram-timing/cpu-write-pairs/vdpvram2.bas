10 ' VDPVRAM2: VDPVRAM's write pair (gap 14 Z80 cycles) in SCREEN 5 with
20 ' sprites on and R#18 = 08h. Result: P8<V>W<w>.BIN (V: 8 = V9938,
30 ' 9 = V9958), the BSAVEd counters of VDPVRAM.BIN: 6 classes x 368 e
40 ' (16 bits), invalid trials, the list of triples; a line in LOG.TXT.
90 CLEAR 300,&H9FFF:SCREEN 0:WIDTH 80:KEY OFF:COLOR 15,4,4
100 BLOAD "VDPVRAM.BIN":DEFUSR=&HC000
110 W=0:IF PEEK(&H2D)>=3 THEN W=1
120 V$="8":IF ((VDP(-1)\2) AND 31)=2 THEN V$="9"
130 F$="P8"+V$+"W"+MID$(STR$(W),2)+".BIN"
140 ON ERROR GOTO 900:OPEN F$ FOR INPUT AS #1:CLOSE #1:ON ERROR GOTO 0:PRINT "Skipping ";F$:GOTO 400
150 ON ERROR GOTO 0:PRINT "SCREEN 5, sprites on, R#18 = 08h, gap 0 -> ";F$
160 POKE &HC003,12:POKE &HC004,100:POKE &HC005,0:POKE &HC006,20:POKE &HC007,W:POKE &HC008,0
170 SCREEN 5:VDP(9)=VDP(9) AND &HFD:VDP(19)=8
180 A=USR(0)
190 V9=VDP(10):V8=VDP(9):V18=VDP(19):VDP(19)=0:SCREEN 0:WIDTH 80
200 BSAVE F$,&HA000,&HB1A0
210 OPEN "LOG.TXT" FOR APPEND AS #1:PRINT #1,F$;" R#8=";V8;" R#9=";V9;" R#18=";V18;" invalid=";PEEK(&HB140)+256*PEEK(&HB141):CLOSE #1
400 PRINT "All done.":POKE &HC008,255:BEEP:END
900 RESUME 150
