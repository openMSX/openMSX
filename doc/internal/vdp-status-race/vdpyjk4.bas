10 ' VDPYJK 4 (V9958): R#23 and the line latch in YJK. Screens 1-2: the
20 ' VDPLINE 4 R#23 staircase (VDPLIN4.BIN) in SCREEN 8 and in SCREEN 12
30 ' (SCREEN 8 with R#25 = 08h): does the seam move with the YJK picture?
40 ' Screens 3-4: VDPYJKN.BIN (16 groups of 8 lines, 1 Z80 cycle later per
50 ' group) writing R#1: display off, and on again 50 Z80 cycles later, over
60 ' a white picture: a line stays black when the latch for it comes while
70 ' the display is off. Does the latch move with YJK? Photo, then space. Then
80 ' VDPLC2.BAS runs by itself (the line counter reset in SCREEN 8 and 12).
90 CLEAR 300,&H9FFF:DEFUSR=&HC000:DEFUSR1=&HB800
100 IF ((VDP(-1)\2) AND 31)<>2 THEN PRINT "Not a V9958.":END
110 W=0:IF PEEK(&H2D)>=3 THEN W=1
120 ' B800h: DI, R#(B810h) = (B80Fh), EI
130 FOR J=0 TO 14:READ B:POKE &HB800+J,B:NEXT
140 BLOAD "VDPLIN4.BIN"
150 FOR I=1 TO 4
160 SCREEN 8:COLOR 255,0,0:CLS:VDP(9)=VDP(9) OR 32
170 T$="VDPYJK 4, screen"+STR$(I)+" of 4":U$="SCREEN 8":IF I=2 OR I=4 THEN U$="SCREEN 12"
180 IF I<3 THEN U$=U$+", R#23" ELSE U$=U$+", R#1 (latch)"
190 LINE (0,0)-(255,38),0,BF:OPEN "GRP:" FOR OUTPUT AS #1
200 PSET (8,8),0:PRINT #1,T$:PSET (8,20),0:PRINT #1,U$:CLOSE #1
210 IF I>2 THEN 260
220 FOR Y=96 TO 167 STEP 16:LINE (0,Y)-(255,Y+7),&HF8,BF:NEXT
230 FOR X=0 TO 255 STEP 8:L=3:IF X MOD 32=0 THEN L=8
240 LINE (X,90-L)-(X,90),&HF8:LINE (X,176)-(X,176+L),&HF8:NEXT
250 C=376:R=23:CA=0:CB=8:GOTO 290
260 LINE (0,44)-(255,211),&HF8,BF
270 IF I=3 THEN BLOAD "VDPYJKN.BIN":DEFUSR=&HA000
280 C=37:CA=PEEK(&HF3E0) OR &H40:CB=CA AND &HBF:V=255:IF I=4 THEN V=8
282 POKE &HA003,C AND 255:POKE &HA004,C\256:POKE &HA005,21:POKE &HA006,W:POKE &HA007,128:POKE &HA00C,2:POKE &HA012,1
284 POKE &HA013,255:POKE &HA014,V:POKE &HA00B,I:POKE &HA008,CA:POKE &HA009,CB:A=USR(0)
286 GOTO 330
290 POKE &HC003,C AND 255:POKE &HC004,C\256:POKE &HC005,21:POKE &HC006,W:POKE &HC007,64:POKE &HC00C,2:POKE &HC012,R
300 IF I=2 OR I=4 THEN POKE &HB80F,8:POKE &HB810,25:A=USR1(0)
310 POKE &HC00B,I:POKE &HC008,CA:POKE &HC009,CB:A=USR(0)
320 POKE &HB80F,0:POKE &HB810,25:A=USR1(0)
330 NEXT
340 SCREEN 0:RUN "VDPLC2.BAS"
1000 DATA &HF3,&H3A,&H0F,&HB8,&HD3,&H99,&H3A,&H10,&HB8,&HF6,&H80,&HD3,&H99,&HFB,&HC9
