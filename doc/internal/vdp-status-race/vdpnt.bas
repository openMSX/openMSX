10 ' VDPNT, fully automatic: NT (R#9 bit 1) changed after N lines from the
20 ' display start; the lines from that write to VR's next four edges.
30 ' Results: N<dir><V>W<w>.TXT, dir A = 50 -> 60 Hz, B = 60 -> 50 Hz,
40 ' V: 8 = V9938, 9 = V9958. Columns: N, then the four counts.
50 CLEAR 200,&HBFFF:SCREEN 0:WIDTH 80:KEY OFF:COLOR 15,4,4
60 BLOAD "VDPNT.BIN":DEFUSR=&HC000
70 W=0:IF PEEK(&H2D)>=3 THEN W=1
80 V$="8":IF ((VDP(-1)\2) AND 31)=2 THEN V$="9"
90 FOR D=0 TO 1
100 IF D=0 THEN A=&H82:B=&H80:D$="A" ELSE A=&H80:B=&H82:D$="B"
110 F$="N"+D$+V$+"W"+MID$(STR$(W),2)+".TXT":PRINT F$
120 OPEN F$ FOR OUTPUT AS #1
130 PRINT #1,"VDPNT W=";W;" R#9 before";A;" after";B
140 RESTORE 1000
150 READ N:IF N<0 THEN 220
160 FOR R=1 TO 2
170 POKE &HC003,N AND 255:POKE &HC004,N\256:POKE &HC005,A:POKE &HC006,B
180 X=USR(0)
190 PRINT #1,N;PEEK(&HC007)+256*PEEK(&HC008);PEEK(&HC009)+256*PEEK(&HC00A);PEEK(&HC00B)+256*PEEK(&HC00C);PEEK(&HC00D)+256*PEEK(&HC00E)
200 NEXT R
210 GOTO 150
220 CLOSE #1
230 NEXT D
240 VDP(10)=PEEK(&HFFE8)
250 PRINT "VDPNT done.":RUN "AUTOEXEC.BAS"
1000 DATA 0,50,100,150,180,200,205,210,212,214,216,218,220,225,230,235,240
1010 DATA 245,248,250,252,254,256,258,260,262,264,266,270,275,280,285,290
1020 DATA 295,298,300,302,304,306,308,310,312,315,320,330,340,-1
