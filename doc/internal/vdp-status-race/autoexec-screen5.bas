10 ' AUTOEXEC: VDPRACE F, FH and VR in SCREEN 5, then VDPEDGE mode 4 in SCREEN 5
20 ' results: R5M<m>W<w>.TXT (VDPRACE) and V6M4S5W<w>.TXT (VDPEDGE)
30 CLEAR 200,&HBFFF:SCREEN 0:WIDTH 80:KEY OFF:COLOR 15,4,4
40 R=32:H=20:Y=191:N=368:LA=&HC800:SA=LA+2*N:BA=SA+2*N:IA=BA+2*N
50 W=0:IF PEEK(&H2D)>=3 THEN W=1
60 PRINT "4 runs in SCREEN 5, about 15 minutes in total, W=";W;". Please wait..."
70 FOR I=1 TO 4:READ M,C
80 IF I<4 THEN F$="R5M"+MID$(STR$(M),2)+"W"+MID$(STR$(W),2)+".TXT":BLOAD "VDPRACE.BIN" ELSE F$="V6M4S5W"+MID$(STR$(W),2)+".TXT":BLOAD "VDPEDGE.BIN"
90 PRINT "Run";I;"of 4 -> ";F$
100 SCREEN 5
110 POKE &HC003,R:POKE &HC004,C AND 255:POKE &HC005,C\256:POKE &HC006,H:POKE &HC007,W:POKE &HC008,M:IF I<4 THEN POKE &HC009,Y
120 DEFUSR=&HC000:A=USR(0)
130 V9=VDP(10):SCREEN 0:WIDTH 80
140 OPEN F$ FOR OUTPUT AS #1
150 PRINT #1,"SCREEN 5 R=";R;" C=";C;" H=";H;" W=";W;" M=";M;" Y=";Y;" R#9=";V9;" invalid=";PEEK(IA)+256*PEEK(IA+1)
160 FOR E=0 TO N-1
170 L=PEEK(LA+2*E)+256*PEEK(LA+2*E+1):S=PEEK(SA+2*E)+256*PEEK(SA+2*E+1):B=PEEK(BA+2*E)+256*PEEK(BA+2*E+1)
180 IF L+S+B>0 THEN PRINT #1,E;L;S;B
190 NEXT
200 IF I=4 THEN HN=PEEK(&HD0A2):PRINT #1,"triples";HN:FOR J=0 TO HN-1:HA=&HD0A3+5*J:PRINT #1,"T";PEEK(HA);PEEK(HA+1);PEEK(HA+2);PEEK(HA+3)+256*PEEK(HA+4):NEXT
210 CLOSE #1:PRINT "   saved, invalid trials:";PEEK(IA)+256*PEEK(IA+1);"of";R*320
220 NEXT
230 PRINT "All done."
240 BEEP:END
250 DATA 0,1227, 1,1075, 2,1227, 4,100
