10 ' VDPLINE: where a write timed relative to HR lands in the picture.
20 ' Each screen: take a photo, then press space.
30 CLEAR 200,&HBFFF:BLOAD "VDPLIN1.BIN"
40 W=0:IF PEEK(&H2D)>=3 THEN W=1
50 POKE &HC003,376 AND 255:POKE &HC004,376\256:POKE &HC005,21:POKE &HC006,W:POKE &HC007,64
60 ' predicted stripe columns (first and last pixel): FS-A1GT if W=1, else HB-F700D
70 IF W=1 THEN M1=24:M2=194:P1=33:P2=203:T1=81:T2=421 ELSE M1=22:M2=189:P1=31:P2=198:T1=79:T2=413
80 COLOR 15,0,4:SCREEN 5:OPEN "GRP:" FOR OUTPUT AS #1
90 PSET (8,8),0:PRINT #1,"VDPLINE SCREEN 5"
100 PSET (8,24),0:PRINT #1,"red: openMSX master (old)"
110 PSET (8,36),0:PRINT #1,"green: openMSX PR 2295 (new)"
120 PSET (8,52),0:PRINT #1,"Photo, then space"
130 FOR X=0 TO 1:LINE (M1+X*(M2-M1),76)-(M1+X*(M2-M1),98),9:LINE (M1+X*(M2-M1),166)-(M1+X*(M2-M1),188),9:NEXT
140 FOR X=0 TO 1:LINE (P1+X*(P2-P1),76)-(P1+X*(P2-P1),98),3:LINE (P1+X*(P2-P1),166)-(P1+X*(P2-P1),188),3:NEXT
150 POKE &HC00B,5:POKE &HC008,4:POKE &HC009,15:DEFUSR=&HC000:A=USR(0)
160 CLOSE #1:COLOR 15,4,4:SCREEN 0:WIDTH 80:KEY OFF
170 PRINT "VDPLINE SCREEN 0 WIDTH 80":PRINT "markers: openMSX master and PR 2295 (the same here)":PRINT "Photo, then space"
180 ' characters 254 and 255: a line at the predicted first and last column (the text starts at x=18)
190 FOR I=0 TO 1:X=T1:IF I=1 THEN X=T2
200 X=X-18:C(I)=X\6:B=2^(7-(X MOD 6)):A=BASE(2)+8*(254+I):FOR J=0 TO 7:VPOKE A+J,B:NEXT:NEXT
210 FOR R=9 TO 11:FOR I=0 TO 1:LOCATE C(I),R:PRINT CHR$(254+I);:NEXT:NEXT
220 FOR R=21 TO 23:FOR I=0 TO 1:LOCATE C(I),R:PRINT CHR$(254+I);:NEXT:NEXT
230 POKE &HC00B,80:POKE &HC008,&HF4:POKE &HC009,&HF8:A=USR(0)
240 RUN "VDPLINE2.BAS"
