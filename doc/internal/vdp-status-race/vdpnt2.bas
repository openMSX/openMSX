10 ' VDPNT 2, fully automatic: VDPNT around the field ends, one line at a
20 ' time and in 14-cycle steps within the line (DLY). Results:
30 ' F<dir><V>W<w>.TXT, dir A = 50 -> 60 Hz, B = 60 -> 50 Hz, V: 8 = V9938,
40 ' 9 = V9958. Columns: N, DLY, then the four counts.
50 CLEAR 200,&HBFFF:SCREEN 0:WIDTH 80:KEY OFF:COLOR 15,4,4
60 BLOAD "VDPNT.BIN":DEFUSR=&HC000
70 W=0:IF PEEK(&H2D)>=3 THEN W=1
80 V$="8":IF ((VDP(-1)\2) AND 31)=2 THEN V$="9"
90 FOR D=0 TO 1
100 IF D=0 THEN A=&H82:B=&H80:D$="A":N0=249:N1=257 ELSE A=&H80:B=&H82:D$="B":N0=224:N1=232
110 F$="F"+D$+V$+"W"+MID$(STR$(W),2)+".TXT":PRINT F$
120 OPEN F$ FOR OUTPUT AS #1
130 PRINT #1,"VDPNT2 W=";W;" R#9 before";A;" after";B
140 FOR N=N0 TO N1:FOR L=0 TO 16 STEP 2:FOR R=1 TO 2
170 POKE &HC003,N AND 255:POKE &HC004,N\256:POKE &HC005,A:POKE &HC006,B:POKE &HC010,L
180 X=USR(0)
190 PRINT #1,N;L;PEEK(&HC007)+256*PEEK(&HC008);PEEK(&HC009)+256*PEEK(&HC00A);PEEK(&HC00B)+256*PEEK(&HC00C);PEEK(&HC00D)+256*PEEK(&HC00E)
200 NEXT R,L,N
220 CLOSE #1
230 NEXT D
240 VDP(10)=PEEK(&HFFE8)
250 PRINT "VDPNT2 done.":RUN "AUTOEXEC.BAS"
