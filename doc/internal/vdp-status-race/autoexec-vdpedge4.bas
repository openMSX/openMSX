10 ' VDPEDGE, fully automatic: mode 4 (VRAM read back) in SCREEN 0 and SCREEN 5, results in V6M<m>S<s>W<w>.TXT
20 CLEAR 200,&HBFFF:SCREEN 0:WIDTH 80:KEY OFF:COLOR 15,4,4
30 BLOAD "VDPEDGE.BIN"
40 R=32:N=368:LA=&HC800:SA=LA+2*N:BA=SA+2*N:IA=BA+2*N
50 ' extra VDP I/O wait on the turboR (MSX version 3)
60 W=0:IF PEEK(&H2D)>=3 THEN W=1
70 PRINT "VDPEDGE automatic run, W=";W;", R#9=";VDP(10)
80 PRINT "2 runs, about 7 minutes in total. Please wait..."
90 FOR I=1 TO 2:READ M,SC
100 H=21:IF SC=5 THEN H=20
110 C=100:IF M=0 THEN C=1075:IF SC=5 THEN C=1227
120 IF M=1 THEN IF (VDP(10) AND 2) THEN C=1987 ELSE C=1599
130 F$="V6M"+MID$(STR$(M),2)+"S"+MID$(STR$(SC),2)+"W"+MID$(STR$(W),2)+".TXT"
140 PRINT "Run";I;"of 2: mode";M;", screen";SC;" -> ";F$
150 IF SC=5 THEN SCREEN 5
160 POKE &HC003,R:POKE &HC004,C AND 255:POKE &HC005,C\256:POKE &HC006,H:POKE &HC007,W:POKE &HC008,M
170 DEFUSR=&HC000:A=USR(0)
180 V9=VDP(10):IF SC=5 THEN SCREEN 0:WIDTH 80
190 OPEN F$ FOR OUTPUT AS #1
200 PRINT #1,"VDPEDGE R=";R;" C=";C;" H=";H;" W=";W;" M=";M;" SC=";SC;" R#9=";V9;" invalid=";PEEK(IA)+256*PEEK(IA+1)
210 FOR E=0 TO N-1
220 L=PEEK(LA+2*E)+256*PEEK(LA+2*E+1):S=PEEK(SA+2*E)+256*PEEK(SA+2*E+1):B=PEEK(BA+2*E)+256*PEEK(BA+2*E+1)
230 IF L+S+B>0 THEN PRINT #1,E;L;S;B
240 NEXT
245 IF M=4 THEN GOSUB 300
250 CLOSE #1:PRINT "   saved, invalid trials:";PEEK(IA)+256*PEEK(IA+1);"of";R*320
260 NEXT
270 PRINT "All done."
280 BEEP:END
290 DATA 4,0, 4,5
300 ' MODE 4: the triples read back from 7000h-7002h, with their counts
310 HN=PEEK(&HD0A2):PRINT #1,"triples";HN
320 FOR J=0 TO HN-1:HA=&HD0A3+5*J
330 PRINT #1,"T";PEEK(HA);PEEK(HA+1);PEEK(HA+2);PEEK(HA+3)+256*PEEK(HA+4)
340 NEXT:RETURN
