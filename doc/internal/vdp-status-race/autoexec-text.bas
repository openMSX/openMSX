10 ' AUTOEXEC: VDPRACE F, FH and VR in SCREEN 0 WIDTH 80 (as in the real runs)
20 CLEAR 200,&HBFFF:SCREEN 0:WIDTH 80:KEY OFF:COLOR 15,4,4
30 R=32:C=1075:H=21:Y=191:N=368:LA=&HC800:SA=LA+2*N:BA=SA+2*N:IA=BA+2*N
40 W=0:IF PEEK(&H2D)>=3 THEN W=1
50 BLOAD "VDPRACE.BIN"
60 FOR M=0 TO 2:F$="T4M"+MID$(STR$(M),2)+"W"+MID$(STR$(W),2)+".TXT"
70 POKE &HC003,R:POKE &HC004,C AND 255:POKE &HC005,C\256:POKE &HC006,H:POKE &HC007,W:POKE &HC008,M:POKE &HC009,Y
80 DEFUSR=&HC000:A=USR(0)
90 OPEN F$ FOR OUTPUT AS #1
100 PRINT #1,"R=";R;" C=";C;" H=";H;" W=";W;" M=";M;" Y=";Y;" R#9=";VDP(10);" invalid=";PEEK(IA)+256*PEEK(IA+1)
110 FOR E=0 TO N-1
120 L=PEEK(LA+2*E)+256*PEEK(LA+2*E+1):S=PEEK(SA+2*E)+256*PEEK(SA+2*E+1):B=PEEK(BA+2*E)+256*PEEK(BA+2*E+1)
130 IF L+S+B>0 THEN PRINT #1,E;L;S;B
140 NEXT:CLOSE #1:PRINT "saved ";F$
150 NEXT
160 PRINT "All done."
