10 ' VDPYJK: does YJK move the picture? Top SCREEN 8, bottom SCREEN 12.
20 CLEAR 200,&HAFFF:BLOAD "VDPYJK.BIN"
30 SCREEN 8:COLOR 255,0,0:CLS:OPEN "GRP:" FOR OUTPUT AS #1
40 PSET (8,8),0:PRINT #1,"VDPYJK: top SCREEN 8, bottom SCREEN 12"
50 PSET (8,20),0:PRINT #1,"same columns: lines in line? Photo, then space"
60 FOR X=16 TO 240 STEP 16:LINE (X,40)-(X,200),&HF8:NEXT
70 FOR X=64 TO 192 STEP 64:LINE (X+1,40)-(X+1,200),&HF8:NEXT
80 POKE &HC005,5:DEFUSR=&HC000:A=USR(0)
90 CLOSE:SCREEN 0:PRINT "Done."
