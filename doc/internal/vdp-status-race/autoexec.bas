10 ' AUTOEXEC for the HB-F700D (V9938, no extra VDP I/O wait): runs the clock
20 ' test and the race test for F, FH and VR without any input. Results: F7*.TXT
30 CLEAR 200,&HBFFF:SCREEN 0:WIDTH 80:KEY OFF
40 W=0:R=32:C=1075:H=21:Y=191:N=368:LA=&HC800:SA=LA+2*N:BA=SA+2*N:IA=BA+2*N
50 PRINT "1/4: clock test":BLOAD "CLKTEST.BIN":POKE &HC003,64:POKE &HC007,W
60 DEFUSR=&HC000:A=USR(0)
70 OPEN "F7CLK.TXT" FOR OUTPUT AS #1:PRINT #1,"W=";W;" N= 64  (C1 C2 per trial, 313 lines = 71364 CPU cycles apart)"
80 FOR I=0 TO 63:PRINT #1,PEEK(&HC200+2*I);PEEK(&HC201+2*I):NEXT:CLOSE #1
90 BLOAD "VDPRACE.BIN"
100 FOR M=0 TO 2
110 PRINT M+2;"/4: race test, mode";M;"(0 = F, 1 = FH, 2 = VR), about 3.5 minutes"
120 POKE &HC003,R:POKE &HC004,C AND 255:POKE &HC005,C\256:POKE &HC006,H:POKE &HC007,W:POKE &HC008,M:POKE &HC009,Y
130 DEFUSR=&HC000:A=USR(0)
140 F$="F7V4M"+MID$(STR$(M),2)+".TXT":OPEN F$ FOR OUTPUT AS #1
150 PRINT #1,"R=";R;" C=";C;" H=";H;" W=";W;" M=";M;" Y=";Y;" R#9=";VDP(10);" R#18=";VDP(19);" invalid=";PEEK(IA)+256*PEEK(IA+1)
160 FOR E=0 TO N-1
170 L=PEEK(LA+2*E)+256*PEEK(LA+2*E+1):S=PEEK(SA+2*E)+256*PEEK(SA+2*E+1):B=PEEK(BA+2*E)+256*PEEK(BA+2*E+1)
180 IF L+S+B>0 THEN PRINT #1,E;L;S;B
190 NEXT:CLOSE #1:PRINT "   saved ";F$
200 NEXT M
210 PRINT "All done.":BEEP
