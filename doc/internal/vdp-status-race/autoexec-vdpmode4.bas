10 ' VDPMODE, fully automatic: which of HR, VR, F and FH move with the screen
20 ' mode, with YJK and with R#18. Results: X<mode><A><B><adjust>W<w>.TXT
30 CLEAR 200,&HBFFF:SCREEN 0:WIDTH 80:KEY OFF:COLOR 15,4,4
40 BLOAD "VDPMODE.BIN"
50 N=368:LA=&HC800:SA=LA+2*N:BA=SA+2*N:IA=BA+2*N
60 W=0:IF PEEK(&H2D)>=3 THEN W=1
70 READ NR
80 PRINT "VDPMODE:";NR;"runs, about 60 minutes, W=";W;". Please wait..."
90 FOR I=1 TO NR:READ M,A$,B$,J,R,H
100 C=1075:IF M=3 THEN C=100
120 J$="N":IF J>0 THEN J$=HEX$(J)
130 F$="X"+MID$(STR$(M),2)+A$+B$+J$+"W"+MID$(STR$(W),2)+".TXT"
140 PRINT "Run";I;"of";NR;": ";F$
150 POKE &HC003,R:POKE &HC004,C AND 255:POKE &HC005,C\256:POKE &HC006,H:POKE &HC007,W:POKE &HC008,M:POKE &HC009,191
160 S$=A$:GOSUB 400:POKE &HC00A,P0:POKE &HC00B,P1
170 S$=B$:GOSUB 400:POKE &HC00C,P0:POKE &HC00D,P1
180 R1=255:IF J>0 THEN R1=J
190 POKE &HC00E,R1:R5=255:IF A$="Y" OR B$="Y" THEN R5=8
195 POKE &HC00F,R5
200 DEFUSR=&HC000:A=USR(0)
210 OPEN F$ FOR OUTPUT AS #1
220 PRINT #1,"VDPMODE R=";R;" C=";C;" H=";H;" W=";W;" M=";M;" A=";A$;" B=";B$;" R#18=";R1;" R#25=";R5;" R#9=";VDP(10);" invalid=";PEEK(IA)+256*PEEK(IA+1)
230 FOR E=0 TO N-1
240 L=PEEK(LA+2*E)+256*PEEK(LA+2*E+1):S=PEEK(SA+2*E)+256*PEEK(SA+2*E+1):B=PEEK(BA+2*E)+256*PEEK(BA+2*E+1)
250 IF L+S+B>0 THEN PRINT #1,E;L;S;B
260 NEXT
270 CLOSE #1:PRINT "   saved, invalid trials:";PEEK(IA)+256*PEEK(IA+1);"of";R*320
280 NEXT
290 PRINT "All done."
300 BEEP:END
400 ' screen mode letter S$ -> M bits of R#0 (P0) and R#1 (P1)
410 ' T = TEXT2, O = TEXT1, A = GRAPHIC1, B = GRAPHIC2, M = MULTICOLOR, C = GRAPHIC3,
415 ' G = GRAPHIC4, D = GRAPHIC5, E = GRAPHIC6, S = GRAPHIC7, Y = GRAPHIC7 + YJK
420 P=INSTR("TOABMCGDESY",S$):P0=VAL("&H"+MID$("40020468AEE",P,1))
430 P1=16*VAL(MID$("11000000000",P,1))+8*VAL(MID$("00001000000",P,1)):RETURN
1000 ' runs: mode (0 F, 1 FH, 2 VR, 3 HR), screen A, screen B, R#18 (0 = unchanged), repetitions, H
1010 DATA 21
1020 DATA 0,O,O,0,16,21, 1,O,O,0,16,21, 3,O,O,0,16,21
1030 DATA 0,A,A,0,16,21, 1,A,A,0,16,21, 3,A,A,0,16,21
1040 DATA 0,B,B,0,16,21, 1,B,B,0,16,21, 3,B,B,0,16,21
1050 DATA 0,M,M,0,16,21, 1,M,M,0,16,21, 3,M,M,0,16,21
1060 DATA 0,C,C,0,16,21, 1,C,C,0,16,21, 3,C,C,0,16,21
1070 DATA 0,D,D,0,16,21, 1,D,D,0,16,21, 3,D,D,0,16,21
1080 DATA 0,E,E,0,16,21, 1,E,E,0,16,21, 3,E,E,0,16,21
