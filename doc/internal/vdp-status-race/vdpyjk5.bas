10 ' VDPYJK 5. On a V9958 (photos, space goes on):
20 ' Screens 1-2: SCREEN 8 and 12, the backdrop stripe edge sweeping through
30 ' the display start (as VDPYJK 3 screens 1-2): photos, and a video of
40 ' screen 2. Screens 3-6: VDPSW.BIN, two writes 57 Z80 cycles apart, 1
50 ' cycle later per group of 8 lines, at C = 374 and 375: SCREEN 5 with R#7
60 ' (where the writes land), then SCREEN 8 with R#25 = 08h and 00h over
70 ' columns every 2 pixels (yellow: SCREEN 8, white: YJK), with a ruler.
80 ' (AUTOEXEC.BAS runs VDPIRQH2.BAS on a V9938 instead.)
90 CLEAR 300,&H9FFF:DEFUSR=&HA000
100 IF ((VDP(-1)\2) AND 31)<>2 THEN PRINT "Not a V9958.":END
110 W=0:IF PEEK(&H2D)>=3 THEN W=1
120 IF W THEN BLOAD "VDPYJKL.BIN" ELSE BLOAD "VDPYJKM.BIN"
130 C=36:POKE &HA003,C AND 255:POKE &HA004,C\256:POKE &HA005,21:POKE &HA006,W:POKE &HA007,128:POKE &HA00C,2:POKE &HA012,7
140 SCREEN 8:COLOR 255,0,0:CLS:VDP(9)=VDP(9) OR 32
150 FOR X=0 TO 240 STEP 16:LINE (X,44)-(X,211),&HF8:NEXT:LINE (255,44)-(255,211),&HF8
160 R5=0:IF PEEK(&H2D)>=2 THEN R5=PEEK(&HFFFA)
170 FOR I=1 TO 2
180 T$="VDPYJK 5, screen"+STR$(I)+" of 6":U$="LEFT border":IF I=2 THEN U$=U$+", and a video"
190 GOSUB 1000
200 V=R5 AND &HE7:IF I=2 THEN V=V OR 8
210 POKE &HA013,8:POKE &HA014,V
220 POKE &HA00B,I:POKE &HA008,&H1F:POKE &HA009,3:A=USR(0)
230 NEXT
240 BLOAD "VDPSW.BIN":DEFUSR=&HC000
250 FOR I=3 TO 6
260 C=374:IF I>4 THEN C=375
270 POKE &HC003,C AND 255:POKE &HC004,C\256:POKE &HC005,21:POKE &HC006,W:POKE &HC007,64:POKE &HC00C,2
280 IF I AND 1 THEN 330
290 SCREEN 8:COLOR 255,0,0:CLS:VDP(9)=VDP(9) OR 32:P=&HF8:R=25:CA=0:CB=8
300 T$="VDPYJK 5, screen"+STR$(I)+" of 6":U$="R#25, C ="+STR$(C)+", whole screen":GOSUB 1000
310 FOR X=0 TO 255 STEP 2:LINE (X,96)-(X,171),P:NEXT
320 GOTO 360
330 SCREEN 5:COLOR 15,0,0:CLS:VDP(9)=VDP(9) AND &HDF:P=15:R=7:CA=0:CB=8
340 T$="VDPYJK 5, screen"+STR$(I)+" of 6":U$="R#7, C ="+STR$(C)+", whole screen":GOSUB 1000
350 FOR X=0 TO 255 STEP 8:LINE (X,96)-(X,171),P:NEXT
360 FOR X=0 TO 255 STEP 8:L=3:IF X MOD 32=0 THEN L=8
370 LINE (X,90-L)-(X,90),P:LINE (X,177)-(X,177+L),P:NEXT
380 POKE &HC012,R:POKE &HC00B,I:POKE &HC008,CA:POKE &HC009,CB:A=USR(0)
390 NEXT
400 SCREEN 0:PRINT "Done."
410 END
1000 LINE (0,0)-(255,38),0,BF:OPEN "GRP:" FOR OUTPUT AS #1
1010 PSET (8,8),0:PRINT #1,T$:PSET (8,20),0:PRINT #1,U$:CLOSE #1:RETURN
