10 ' VDPADJ, fully automatic: VR and F with R#18 changed between the HR
20 ' samples (R#18 = 00h) and the read. Results: A<mode><screen><R#18 B>W<w>.TXT
30 CLEAR 200,&HBFFF:SCREEN 0:WIDTH 80:KEY OFF:COLOR 15,4,4
40 BLOAD "VDPADJ.BIN"
50 N=368:LA=&HC800:SA=LA+2*N:BA=SA+2*N:IA=BA+2*N
60 W=0:IF PEEK(&H2D)>=3 THEN W=1
70 READ NR
80 PRINT "VDPADJ:";NR;"runs, about 25 minutes, W=";W;". Please wait..."
90 FOR I=1 TO NR:READ M,A$,J,R
100 C=1075:H=21
130 F$="A"+MID$(STR$(M),2)+A$+HEX$(J)+"W"+MID$(STR$(W),2)+".TXT"
140 PRINT "Run";I;"of";NR;": ";F$
150 POKE &HC003,R:POKE &HC004,C AND 255:POKE &HC005,C\256:POKE &HC006,H:POKE &HC007,W:POKE &HC008,M:POKE &HC009,191
160 S$=A$:GOSUB 400:POKE &HC00A,P0:POKE &HC00B,P1:POKE &HC00C,P0:POKE &HC00D,P1
190 POKE &HC00E,0:POKE &HC00F,255:POKE &HC010,J
200 DEFUSR=&HC000:A=USR(0)
210 OPEN F$ FOR OUTPUT AS #1
220 PRINT #1,"VDPADJ R=";R;" C=";C;" H=";H;" W=";W;" M=";M;" A=";A$;" R#18 A=0 B=";J;" R#9=";VDP(10);" invalid=";PEEK(IA)+256*PEEK(IA+1)
230 FOR E=0 TO N-1
240 L=PEEK(LA+2*E)+256*PEEK(LA+2*E+1):S=PEEK(SA+2*E)+256*PEEK(SA+2*E+1):B=PEEK(BA+2*E)+256*PEEK(BA+2*E+1)
250 IF L+S+B>0 THEN PRINT #1,E;L;S;B
260 NEXT
270 CLOSE #1:PRINT "   saved, invalid trials:";PEEK(IA)+256*PEEK(IA+1);"of";R*320
280 NEXT
290 PRINT "All done."
300 BEEP:END
400 ' screen mode letter S$ -> M bits of R#0 (P0) and R#1 (P1): T = TEXT2, G = GRAPHIC4
410 IF S$="T" THEN P0=4:P1=16 ELSE P0=6:P1=0
420 RETURN
1000 ' runs: mode (0 F, 2 VR), screen, R#18 from the read on, repetitions
1010 DATA 20
1020 DATA 2,G,0,8, 2,G,2,8, 2,G,7,8, 2,G,8,8, 2,G,15,8
1030 DATA 0,G,0,8, 0,G,2,8, 0,G,7,8, 0,G,8,8, 0,G,15,8
1040 DATA 2,T,0,8, 2,T,2,8, 2,T,7,8, 2,T,8,8, 2,T,15,8
1050 DATA 0,T,0,8, 0,T,2,8, 0,T,7,8, 0,T,8,8, 0,T,15,8
