10 ' VDPMODE, fully automatic: which of HR, VR, F and FH move with the screen
20 ' mode and with R#18. Results: X<mode><A><B><adjust>W<w>.TXT
30 CLEAR 200,&HBFFF:SCREEN 0:WIDTH 80:KEY OFF:COLOR 15,4,4
40 BLOAD "VDPMODE.BIN"
50 N=368:LA=&HC800:SA=LA+2*N:BA=SA+2*N:IA=BA+2*N
60 W=0:IF PEEK(&H2D)>=3 THEN W=1
70 READ NR
80 PRINT "VDPMODE:";NR;"runs, about 15 minutes, W=";W;". Please wait..."
90 FOR I=1 TO NR:READ M,A$,B$,J,R,H
100 C=1075:IF M=3 THEN C=100
120 J$="N":IF J=7 THEN J$="7" ELSE IF J=8 THEN J$="8"
130 F$="X"+MID$(STR$(M),2)+A$+B$+J$+"W"+MID$(STR$(W),2)+".TXT"
140 PRINT "Run";I;"of";NR;": ";F$
150 POKE &HC003,R:POKE &HC004,C AND 255:POKE &HC005,C\256:POKE &HC006,H:POKE &HC007,W:POKE &HC008,M:POKE &HC009,191
160 IF A$="T" THEN POKE &HC00A,4:POKE &HC00B,16 ELSE POKE &HC00A,6:POKE &HC00B,0
170 IF B$="T" THEN POKE &HC00C,4:POKE &HC00D,16 ELSE POKE &HC00C,6:POKE &HC00D,0
180 R1=255:IF J=7 THEN R1=7 ELSE IF J=8 THEN R1=8
190 POKE &HC00E,R1
200 DEFUSR=&HC000:A=USR(0)
210 OPEN F$ FOR OUTPUT AS #1
220 PRINT #1,"VDPMODE R=";R;" C=";C;" H=";H;" W=";W;" M=";M;" A=";A$;" B=";B$;" R#18=";R1;" R#9=";VDP(10);" invalid=";PEEK(IA)+256*PEEK(IA+1)
230 FOR E=0 TO N-1
240 L=PEEK(LA+2*E)+256*PEEK(LA+2*E+1):S=PEEK(SA+2*E)+256*PEEK(SA+2*E+1):B=PEEK(BA+2*E)+256*PEEK(BA+2*E+1)
250 IF L+S+B>0 THEN PRINT #1,E;L;S;B
260 NEXT
270 CLOSE #1:PRINT "   saved, invalid trials:";PEEK(IA)+256*PEEK(IA+1);"of";R*320
280 NEXT
290 PRINT "All done."
300 BEEP:END
1000 ' runs: mode (0 F, 1 FH, 2 VR, 3 HR), screen A, screen B, R#18 (0 = unchanged), repetitions, H
1010 DATA 5
1020 DATA 3,T,T,7,16,21, 1,T,T,7,16,21, 1,T,T,8,16,21
1030 DATA 1,G,G,7,16,20, 1,G,G,8,16,21
