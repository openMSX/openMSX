10 ' VDPYJK 3 (V9958). Screens 1-2: SCREEN 8 and 12, a backdrop stripe
20 ' edge sweeping through the display start (16 groups, 1 Z80 cycle per
30 ' group; VDPYJKL.BIN on a turboR, VDPYJKM.BIN, 6 cycles later, else).
40 ' Screens 3-6: VDPSW.BIN, two writes 57 Z80 cycles apart in the
50 ' picture, 1 cycle later per group of 8 lines: SCREEN 5 with R#7 (the
60 ' backdrop shows where the writes land) and SCREEN 8 with R#25 (YJK on,
70 ' then off), at two moments (C = 374 and 375, 45 pixels apart).
80 ' Screens 7-8: SCREEN 8 and 5, nothing written, interrupts off: the
90 ' bright band at the right? Photo, then space.
100 CLEAR 300,&H9FFF:DEFUSR=&HA000
110 IF ((VDP(-1)\2) AND 31)<>2 THEN PRINT "Not a V9958.":END
120 W=0:IF PEEK(&H2D)>=3 THEN W=1
130 IF W THEN BLOAD "VDPYJKL.BIN" ELSE BLOAD "VDPYJKM.BIN"
140 C=36:POKE &HA003,C AND 255:POKE &HA004,C\256:POKE &HA005,21:POKE &HA006,W:POKE &HA007,128:POKE &HA00C,2:POKE &HA012,7
150 SCREEN 8:COLOR 255,0,0:CLS:VDP(9)=VDP(9) OR 32
160 FOR X=0 TO 240 STEP 16:LINE (X,44)-(X,211),&HF8:NEXT:LINE (255,44)-(255,211),&HF8
170 R5=0:IF PEEK(&H2D)>=2 THEN R5=PEEK(&HFFFA)
180 FOR I=1 TO 2
190 T$="VDPYJK 3, screen"+STR$(I)+" of 8":U$="Photo of the LEFT border":GOSUB 1000
200 V=R5 AND &HE7:IF I=2 THEN V=V OR 8
210 POKE &HA013,8:POKE &HA014,V
220 POKE &HA00B,I:POKE &HA008,&H1F:POKE &HA009,3:A=USR(0)
230 NEXT
240 BLOAD "VDPSW.BIN":DEFUSR=&HC000
250 FOR I=3 TO 6
260 C=374:IF I>4 THEN C=375
270 POKE &HC003,C AND 255:POKE &HC004,C\256:POKE &HC005,21:POKE &HC006,W:POKE &HC007,64:POKE &HC00C,2
280 IF I AND 1 THEN 300
290 SCREEN 8:COLOR 255,0,0:CLS:VDP(9)=VDP(9) OR 32:P=&HF8:R=25:CA=0:CB=8:GOTO 310
300 SCREEN 5:COLOR 15,0,0:CLS:VDP(9)=VDP(9) AND &HDF:P=15:R=7:CA=0:CB=8
310 T$="VDPYJK 3, screen"+STR$(I)+" of 8":U$="R#"+MID$(STR$(R),2)+", C ="+STR$(C)+", whole screen":GOSUB 1000
320 FOR X=0 TO 255 STEP 8:LINE (X,44)-(X,211),P:NEXT
330 FOR X=0 TO 255 STEP 32:LINE (X+1,44)-(X+1,211),P:NEXT
340 POKE &HC012,R:POKE &HC00B,I:POKE &HC008,CA:POKE &HC009,CB:A=USR(0)
350 NEXT
360 FOR J=0 TO 28:READ B:POKE &HB800+J,B:NEXT:DEFUSR=&HB800
370 FOR I=7 TO 8
380 IF I=7 THEN SCREEN 8:COLOR 255,0,3:CLS:VDP(9)=VDP(9) OR 32:P=&HF8 ELSE SCREEN 5:COLOR 15,0,4:CLS:VDP(9)=VDP(9) AND &HDF:P=15
390 T$="VDPYJK 3, screen"+STR$(I)+" of 8":U$="no writes: right border band?":GOSUB 1000
400 FOR X=0 TO 240 STEP 16:LINE (X,44)-(X,211),P:NEXT:LINE (255,44)-(255,211),P
410 A=USR(0)
420 NEXT
430 SCREEN 0:PRINT "Done."
440 END
1000 LINE (0,0)-(255,38),0,BF:OPEN "GRP:" FOR OUTPUT AS #1
1010 PSET (8,8),0:PRINT #1,T$:PSET (8,20),0:PRINT #1,U$:CLOSE #1:RETURN
2000 ' DI, wait until space is released, then until it is pressed, EI
2010 DATA &HF3,&HDB,&HAA,&HE6,&HF0,&HF6,8,&HD3,&HAA,&HDB,&HA9,&H0F,&H30,&HF3
2020 DATA &HDB,&HAA,&HE6,&HF0,&HF6,8,&HD3,&HAA,&HDB,&HA9,&H0F,&H38,&HF3,&HFB
2030 DATA &HC9
