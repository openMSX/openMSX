10 ' VDPLINE 3: where a write timed relative to HR lands in the picture.
20 ' Three screens; for each: take a photo, then press space. White stripe on black.
30 CLEAR 300,&HBFFF:BLOAD "VDPLIN3.BIN":DEFUSR=&HC000:DIM CC(3),SB(3),DB(3)
40 W=0:IF PEEK(&H2D)>=3 THEN W=1
50 POKE &HC005,21:POKE &HC006,W:POKE &HC007,64
60 FOR SC=1 TO 3
70 READ T$,MD,CO:FOR I=0 TO 1:FOR J=0 TO 7:READ P(I,J):NEXT:NEXT
80 POKE &HC003,CO AND 255:POKE &HC004,CO\256:POKE &HC00C,0:POKE &HC005,21+(MD=5)
85 FOR I=0 TO 97:POKE &HD000+I,0:NEXT
90 IF MD=5 THEN GOSUB 200 ELSE GOSUB 300
100 POKE &HC00B,SC:A=USR(0)
105 FOR I=0 TO 97:POKE &HD000+SC*128+I,PEEK(&HD000+I):NEXT
110 NEXT
120 CLOSE:SCREEN 0:WIDTH 80:COLOR 15,4,4
125 F$="HISTW"+MID$(STR$(W),2)+".TXT":OPEN F$ FOR OUTPUT AS #1
130 PRINT #1,"VDPLINE 3, W=";W;": per screen (SCREEN 5, 80, 40), frames per CNT 0..48"
135 FOR SC=1 TO 3:FOR I=0 TO 48:A=&HD000+SC*128+2*I:PRINT #1,PEEK(A)+256*PEEK(A+1);:NEXT:PRINT #1,"":NEXT
140 CLOSE #1:PRINT "Photos done. Saved: ";F$
150 END
200 ' SCREEN 5: solid line = lag 24, dotted line = lag 33
210 COLOR 15,0,1:SCREEN 5:OPEN "GRP:" FOR OUTPUT AS #1
220 PSET (8,8),0:PRINT #1,T$
230 PSET (8,24),0:PRINT #1,"solid: lag 24 cycles"
240 PSET (8,36),0:PRINT #1,"dotted: lag 33 cycles"
250 PSET (8,52),0:PRINT #1,"Photo, then space"
260 FOR J=0 TO 3:X=P(W,J):X2=P(W,J+4):IF X<0 THEN 280
270 FOR Y=0 TO 22:IF J<2 OR (Y AND 1)=0 THEN PSET (X,76+Y),15:PSET (X2,166+Y),15
275 NEXT
280 NEXT
290 POKE &HC008,1:POKE &HC009,15:RETURN
300 ' text mode: solid = lag 24, dotted = lag 33; markers in one column share a character
310 CLOSE:COLOR 15,1,1:SCREEN 0:WIDTH MD:KEY OFF:CLS
320 PRINT T$:PRINT "solid: lag 24 cycles, dotted: lag 33 cycles":PRINT "Photo, then space"
330 O=18:PW=6:IF MD=40 THEN O=9
340 FOR BD=0 TO 1:N=0
345 FOR J=0 TO 3:X=P(W,J+4*BD):IF X<0 THEN 360
350 X=X-O:C=X\PW:B=2^(7-(X MOD PW)):K=0
352 IF K<N THEN IF CC(K)<>C THEN K=K+1:GOTO 352
354 IF K=N THEN CC(K)=C:SB(K)=0:DB(K)=0:N=N+1
356 IF J<2 THEN SB(K)=SB(K) OR B ELSE DB(K)=DB(K) OR B
360 NEXT
365 FOR K=0 TO N-1:CH=248+4*BD+K:A=BASE(2)+8*CH
370 FOR R=0 TO 7:V=SB(K):IF (R AND 1)=0 THEN V=V OR DB(K)
372 VPOKE A+R,V:NEXT
375 FOR R=9+12*BD TO 11+12*BD:LOCATE CC(K),R:PRINT CHR$(CH);:NEXT
380 NEXT:NEXT
395 POKE &HC008,&HF1:POKE &HC009,&HFF:RETURN
1000 ' per screen: title, mode (5, 80 or 40), coarse, then the markers (first and
1010 ' last stripe pixel, lag 24 then lag 33, top band then bottom band; -1 = none)
1020 ' for W=0 (computed for the Sony HB-F700D: no extra wait, clocks locked), then W=1 (turboR)
1040 DATA "SCREEN 5, R#7 write",5,364, 39,206,36,203,39,206,36,203, 40,210,38,208,40,210,38,208
1060 DATA "SCREEN 0 WIDTH 80, R#7 write",80,372, 129,464,124,459,129,464,124,459, 132,473,127,468,132,473,127,468
1080 DATA "SCREEN 0 WIDTH 40, R#7 write",40,372, 64,231,62,229,64,231,62,229, 66,236,63,233,66,236,63,233
