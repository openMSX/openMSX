10 ' VDPLC 2, fully automatic: the line-count reset in SCREEN 8 (E) and
20 ' SCREEN 12 (Y: SCREEN 8 with R#25 = 08h). Results: L<mode><R#18>W<w>.TXT
30 CLEAR 200,&HBFFF:SCREEN 0:WIDTH 80:KEY OFF:COLOR 15,4,4
40 BLOAD "VDPLC.BIN"
50 N=368:LA=&HC800:SA=LA+2*N:BA=SA+2*N:IA=BA+2*N
60 W=0:IF PEEK(&H2D)>=3 THEN W=1
70 READ NR
80 PRINT "VDPLC:";NR;"runs, about 12 minutes, W=";W;". Please wait..."
90 FOR I=1 TO NR:READ A$,J,R,H
100 C=1658:C2=368:IF (VDP(10) AND 2)=0 THEN C=1476:C2=163 ' 50 Hz / 60 Hz
130 F$="L"+A$+HEX$(J)+"W"+MID$(STR$(W),2)+".TXT"
140 PRINT "Run";I;"of";NR;": ";F$
150 POKE &HC003,R:POKE &HC004,C AND 255:POKE &HC005,C\256:POKE &HC006,H:POKE &HC007,W:POKE &HC010,C2 AND 255:POKE &HC011,C2\256
160 S$=A$:GOSUB 400:POKE &HC00A,P0:POKE &HC00B,P1:POKE &HC00C,P0:POKE &HC00D,P1
190 POKE &HC00E,J:POKE &HC00F,255:IF S$="Y" THEN POKE &HC00F,8
200 DEFUSR=&HC000:A=USR(0)
210 OPEN F$ FOR OUTPUT AS #1
220 PRINT #1,"VDPLC R=";R;" C=";C;" C2=";C2;" H=";H;" W=";W;" A=";A$;" R#18=";J;" R#9=";VDP(10);" invalid=";PEEK(IA)+256*PEEK(IA+1)
230 FOR E=0 TO N-1
240 L=PEEK(LA+2*E)+256*PEEK(LA+2*E+1):S=PEEK(SA+2*E)+256*PEEK(SA+2*E+1):B=PEEK(BA+2*E)+256*PEEK(BA+2*E+1)
250 IF L+S+B>0 THEN PRINT #1,E;L;S;B
260 NEXT
270 CLOSE #1:PRINT "   saved, invalid trials:";PEEK(IA)+256*PEEK(IA+1);"of";R*320
280 NEXT
290 PRINT "All done."
300 BEEP:END
400 ' screen mode letter S$ -> M bits of R#0 (P0) and R#1 (P1): E, Y = GRAPHIC7
410 P0=14:P1=0
420 RETURN
1000 ' runs: screen, R#18, repetitions, H
1010 DATA 4
1020 DATA E,0,8,21, Y,0,8,21, E,8,8,21, Y,8,8,21
