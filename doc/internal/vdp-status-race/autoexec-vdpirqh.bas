10 ' VDPIRQH, fully automatic: when does the line interrupt come, relative to FH?
20 ' Results: H<A><B>W<w>.TXT with e, lost, seen, before, pulse.
30 CLEAR 200,&HAFFF:SCREEN 0:WIDTH 80:KEY OFF:COLOR 15,4,4
40 BLOAD "VDPIRQH.BIN"
50 N=368:LA=&HC800:SA=LA+2*N:BA=SA+2*N:PA=BA+2*N:IA=PA+2*N
60 W=0:IF PEEK(&H2D)>=3 THEN W=1
70 READ NR
80 PRINT "VDPIRQH:";NR;"runs, about 10 minutes, W=";W;". Please wait..."
90 FOR I=1 TO NR:READ A$,B$,R,H
100 C=1075
130 F$="H"+A$+B$+"W"+MID$(STR$(W),2)+".TXT"
140 PRINT "Run";I;"of";NR;": ";F$
150 POKE &HC003,R:POKE &HC004,C AND 255:POKE &HC005,C\256:POKE &HC006,H:POKE &HC007,W:POKE &HC008,1:POKE &HC009,191
160 S$=A$:GOSUB 400:POKE &HC00A,P0:POKE &HC00B,P1
170 S$=B$:GOSUB 400:POKE &HC00C,P0:POKE &HC00D,P1
190 POKE &HC00E,255:POKE &HC00F,255
200 DEFUSR=&HC000:A=USR(0)
210 OPEN F$ FOR OUTPUT AS #1
220 PRINT #1,"VDPIRQH R=";R;" C=";C;" H=";H;" W=";W;" A=";A$;" B=";B$;" R#9=";VDP(10);" invalid=";PEEK(IA)+256*PEEK(IA+1)
230 FOR E=0 TO N-1
240 L=PEEK(LA+2*E)+256*PEEK(LA+2*E+1):S=PEEK(SA+2*E)+256*PEEK(SA+2*E+1):B=PEEK(BA+2*E)+256*PEEK(BA+2*E+1):P=PEEK(PA+2*E)+256*PEEK(PA+2*E+1)
250 IF L+S+B+P>0 THEN PRINT #1,E;L;S;B;P
260 NEXT
270 CLOSE #1:PRINT "   saved, invalid trials:";PEEK(IA)+256*PEEK(IA+1);"of";R*320
280 NEXT
290 PRINT "All done."
300 BEEP:END
400 ' screen mode letter S$ -> M bits of R#0 (P0) and R#1 (P1): T = TEXT2, G = GRAPHIC4
410 IF S$="T" THEN P0=4:P1=16 ELSE P0=6:P1=0
420 RETURN
1000 ' runs: screen A, screen B, repetitions, H
1010 DATA 2
1020 DATA T,T,32,21, G,G,32,21
