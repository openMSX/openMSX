# Builds libepoxy.
#
# libepoxy only ships a meson build, which does not fit in with the rest of
# the 3rd party system. Its build is small enough to do directly: generate the
# dispatch tables from the Khronos registry, then compile a handful of files.
#
# build/3rdparty.mk copies this file into the build directory as "Makefile" and
# passes SRC_DIR, INSTALL_DIR, PYTHON, EPOXY_APIS and CFLAGS; CC, AR and RANLIB
# come from the environment.
#
# The source lists below mirror libepoxy's src/meson.build; diff against it
# when updating the version.

.PHONY: all install

# "gl" is always built and is the only API without a dispatch source of its own.
EXTRA_APIS:=$(filter-out gl,$(EPOXY_APIS))

GEN_HEADERS:=$(EPOXY_APIS:%=gen/epoxy/%_generated.h)
GEN_SOURCES:=$(EPOXY_APIS:%=gen/%_generated_dispatch.c)
OBJECTS:=dispatch_common.o \
	$(EXTRA_APIS:%=dispatch_%.o) \
	$(EPOXY_APIS:%=%_generated_dispatch.o)

# config.h is picked up from the build directory, the generated headers are
# included as <epoxy/...> so "gen" itself goes on the include path.
INCLUDES:=-I. -Igen -I$(SRC_DIR)/include -I$(SRC_DIR)/src

all: libepoxy.a

# The generated files are made by pattern rules, so make treats them as
# intermediates and deletes them when it is done; "install" runs as a separate
# invocation and needs the headers to still be there.
.SECONDARY: $(GEN_HEADERS) $(GEN_SOURCES)

# Which APIs exist is decided by the caller, so the platform conditionals in
# libepoxy's config.h reduce to whether we were asked to build them. ENABLE_X11
# is only consulted when EGL is enabled.
config.h: Makefile
	@echo '/* Generated by build/3rdparty-epoxy.mk. */' > $@
	@echo '#define ENABLE_EGL $(if $(filter egl,$(EPOXY_APIS)),1,0)' >> $@
	@echo '#define ENABLE_GLX $(if $(filter glx,$(EPOXY_APIS)),1,0)' >> $@
	@echo '#define ENABLE_X11 $(if $(filter egl glx,$(EPOXY_APIS)),1,0)' >> $@

# Source and header are generated by separate rules: a rule with two targets
# runs its recipe once per target, so asking for both in one invocation would
# leave whichever target make did not ask for missing.
gen/%_generated_dispatch.c: \
  $(SRC_DIR)/registry/%.xml $(SRC_DIR)/src/gen_dispatch.py
	mkdir -p gen/epoxy
	$(PYTHON) $(SRC_DIR)/src/gen_dispatch.py --source --no-header \
		--srcdir gen --includedir gen/epoxy $<

gen/epoxy/%_generated.h: \
  $(SRC_DIR)/registry/%.xml $(SRC_DIR)/src/gen_dispatch.py
	mkdir -p gen/epoxy
	$(PYTHON) $(SRC_DIR)/src/gen_dispatch.py --header --no-source \
		--srcdir gen --includedir gen/epoxy $<

dispatch_%.o: $(SRC_DIR)/src/dispatch_%.c config.h $(GEN_HEADERS)
	$(CC) $(CFLAGS) $(INCLUDES) -c -o $@ $<

%_generated_dispatch.o: gen/%_generated_dispatch.c config.h $(GEN_HEADERS)
	$(CC) $(CFLAGS) $(INCLUDES) -c -o $@ $<

libepoxy.a: $(OBJECTS)
	rm -f $@
	$(AR) rc $@ $(OBJECTS)
	$(RANLIB) $@

install: all
	mkdir -p $(INSTALL_DIR)/lib $(INSTALL_DIR)/include/epoxy
	cp libepoxy.a $(INSTALL_DIR)/lib/
	cp $(SRC_DIR)/include/epoxy/common.h $(INSTALL_DIR)/include/epoxy/
	cp $(SRC_DIR)/include/epoxy/gl.h $(INSTALL_DIR)/include/epoxy/
	$(foreach API,$(EXTRA_APIS), \
		cp $(SRC_DIR)/include/epoxy/$(API).h $(INSTALL_DIR)/include/epoxy/ &&) true
	cp $(GEN_HEADERS) $(INSTALL_DIR)/include/epoxy/
