  <ItemGroup>
    <!-- libepoxy generates config.h from its own build system; for the Visual C++
         build we keep a hand-written equivalent next to this project file. -->
    <CustomBuild Include="libepoxy-config.h">
      <Message>Installing libepoxy config.h...</Message>
      <Command>if not exist "$(EpoxyGenDir)" mkdir "$(EpoxyGenDir)"
copy /y "%(FullPath)" "$(EpoxyGenDir)\config.h" &gt; nul</Command>
      <Outputs>$(EpoxyGenDir)\config.h</Outputs>
    </CustomBuild>
    <!-- The dispatch tables and their headers are generated from the Khronos XML
         registry, the same way libepoxy's own build system does it. -->
    <CustomBuild Include="$(EpoxySrcDir)\registry\gl.xml">
      <Message>Generating GL dispatch tables...</Message>
      <Command>if not exist "$(EpoxyGenDir)" mkdir "$(EpoxyGenDir)"
if not exist "$(EpoxyIncDir)" mkdir "$(EpoxyIncDir)"
py "$(EpoxySrcDir)\src\gen_dispatch.py" --source --header --srcdir "$(EpoxyGenDir)" --includedir "$(EpoxyIncDir)" "%(FullPath)"</Command>
      <AdditionalInputs>$(EpoxySrcDir)\src\gen_dispatch.py;%(AdditionalInputs)</AdditionalInputs>
      <Outputs>$(EpoxyGenDir)\gl_generated_dispatch.c;$(EpoxyIncDir)\gl_generated.h</Outputs>
    </CustomBuild>
    <CustomBuild Include="$(EpoxySrcDir)\registry\wgl.xml">
      <Message>Generating WGL dispatch tables...</Message>
      <Command>if not exist "$(EpoxyGenDir)" mkdir "$(EpoxyGenDir)"
if not exist "$(EpoxyIncDir)" mkdir "$(EpoxyIncDir)"
py "$(EpoxySrcDir)\src\gen_dispatch.py" --source --header --srcdir "$(EpoxyGenDir)" --includedir "$(EpoxyIncDir)" "%(FullPath)"</Command>
      <AdditionalInputs>$(EpoxySrcDir)\src\gen_dispatch.py;%(AdditionalInputs)</AdditionalInputs>
      <Outputs>$(EpoxyGenDir)\wgl_generated_dispatch.c;$(EpoxyIncDir)\wgl_generated.h</Outputs>
    </CustomBuild>
    <!-- Public headers, installed next to the generated ones so that openMSX only
         needs a single epoxy include directory. -->
    <CustomBuild Include="$(EpoxySrcDir)\include\epoxy\common.h">
      <Message>Installing epoxy/common.h...</Message>
      <Command>if not exist "$(EpoxyIncDir)" mkdir "$(EpoxyIncDir)"
copy /y "%(FullPath)" "$(EpoxyIncDir)\common.h" &gt; nul</Command>
      <Outputs>$(EpoxyIncDir)\common.h</Outputs>
    </CustomBuild>
    <CustomBuild Include="$(EpoxySrcDir)\include\epoxy\gl.h">
      <Message>Installing epoxy/gl.h...</Message>
      <Command>if not exist "$(EpoxyIncDir)" mkdir "$(EpoxyIncDir)"
copy /y "%(FullPath)" "$(EpoxyIncDir)\gl.h" &gt; nul</Command>
      <Outputs>$(EpoxyIncDir)\gl.h</Outputs>
    </CustomBuild>
    <CustomBuild Include="$(EpoxySrcDir)\include\epoxy\wgl.h">
      <Message>Installing epoxy/wgl.h...</Message>
      <Command>if not exist "$(EpoxyIncDir)" mkdir "$(EpoxyIncDir)"
copy /y "%(FullPath)" "$(EpoxyIncDir)\wgl.h" &gt; nul</Command>
      <Outputs>$(EpoxyIncDir)\wgl.h</Outputs>
    </CustomBuild>
  </ItemGroup>
