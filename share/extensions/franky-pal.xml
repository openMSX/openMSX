<?xml version="1.0" ?>
<!DOCTYPE msxconfig SYSTEM 'msxconfig2.dtd'>
<msxconfig>
  <info>
    <name>Franky PAL</name>
    <manufacturer>SuperSoniqs</manufacturer>
    <code/>
    <release_year>2009</release_year>
    <description>Franky cartridge in PAL / VDP2 config. See doc/Franky.md for more info and for how to create a VDP1 variant.</description>
