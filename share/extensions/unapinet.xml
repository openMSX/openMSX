<?xml version="1.0" ?>
<!DOCTYPE msxconfig SYSTEM 'msxconfig2.dtd'>
<msxconfig>
  <info>
    <name>UnapiNet</name>
    <manufacturer>openMSXnet</manufacturer>
    <code/>
    <release_year>2026</release_year>
    <description>UNAPI TCP/IP bridge. Provides real network access to MSX via I/O ports 0x28-0x29 (same range as the DenYoNet Ethernet card; both are UNAPI Ethernet bridges and are not loaded together).</description>
    <type>network</type>
  </info>
  <devices>
    <UnapiNet id="UnapiNet">
      <!-- 0x28 is write-only (command); replies, status byte included,
           are read from 0x29. Reading 0x28 hits the open bus. -->
      <io base="0x28" num="2" type="O"/>
      <io base="0x29" num="1" type="I"/>
    </UnapiNet>
  </devices>
</msxconfig>
