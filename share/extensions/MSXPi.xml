<?xml version="1.0" ?>
<!DOCTYPE msxconfig SYSTEM 'msxconfig2.dtd'>
<msxconfig>
  <info>
    <name>MSXPi</name>
    <manufacturer>MSXPi (https://github.com/costarc/MSXPi)</manufacturer>
    <code/>
    <release_year/>
    <description>MSXPi is an extension for openMSX that emulates the MSXPi hardware interface, enabling an MSX computer to interact with modern systems. Unlike the physical version, the emulated interface does not require a Raspberry Pi — it communicates with a Python-based server component that provides access to web resources, files, REST APIs, and other external services. Newer versions of the msxpibios.rom and the corresponding MSXPi server can be downloaded from the MSXPi repository at https://github.com/costarc/MSXPi/tree/master/software.</description>
    <type>pluggable</type>
  </info>
  <devices>
    <primary slot="any">
      <secondary slot="any">
        <MSXPiDevice id="MSXPi">
          <io base="0x56" num="1"/>
          <io base="0x57" num="1"/>
          <io base="0x5A" num="1"/>
          <!-- Timing of the emulated Raspberry Pi, in microseconds of emulated
               time. transfer_time: how long the Pi takes to clock one byte, which
               is also how long a /WAIT stall lasts. ready_tail: how long the Pi
               keeps READY up after the last clock of a byte; above 0 it opens the
               window in which a burst write can start before the Pi is ready.
               ready_gap: how long READY stays low between two separately
               offered bytes, before the Pi raises it for the next one. -->
          <transfer_time>20</transfer_time>
          <ready_tail>0</ready_tail>
          <ready_gap>0</ready_gap>
        </MSXPiDevice>
        <ROM id="MSXPi BIOS">
          <mem base="0x4000" size="0x4000"/>
          <rom>
            <sha1>4f56b1971b247b676d97825442c258715cdce2af</sha1> <!-- Build 1.6.20260913.052 - BASIC BIOS, MSX-DOS1, UNAPI; no emulator branch, needs the CPLD-exact device-->
            <sha1>0a62a0b3ee8eba92f15ec46f9c3055be06d32a9f</sha1> <!-- Build 1.6.20260913.051 - BASIC BIOS, MSX-DOS1, UNAPI and Performance improvements-->
            <sha1>3cfffa59afef160439085a8a496953edcaeb0662</sha1> <!-- Build 1.5.20260808.020 - BASIC BIOS and MSX-DOS1-->
            <sha1>c429077a5f58b006125247a67783ea4ea6fb7389</sha1> <!-- Build 1.2.20250923.792 - BASIC BIOS only-->
            <filename>msxpibios.rom</filename>
          </rom>
        </ROM>
      </secondary>
    </primary>
  </devices>
</msxconfig>